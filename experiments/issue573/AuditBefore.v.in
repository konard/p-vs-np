From Stdlib Require Import List Bool.
Import ListNotations.
From proofs.p_eq_np.rocq Require Import PvsNP.

(** The old relation accepts any Boolean computation as a one-bit reduction. *)
Theorem audit_arbitrary_boolean_reduction (g : BinaryString -> bool) :
  poly_time_reduction (fun x => g x = true) (fun y => y = [true]).
Proof.
  exists (fun x => [g x]), (fun _ => 1).
  split; [apply constant_is_poly |].
  split; [intro x; simpl; auto |].
  intro x. destruct (g x); simpl; split; congruence.
Qed.
